---
/**
 * Homepage hero: the Vancouver skyline at blue hour, and a scroll tour of the site's sections.
 *
 * Progressive enhancement:
 *  - Always: a pre-rendered poster (the LCP image) + the headline + "Skip to work". Works without JS.
 *  - With motion allowed: one scroll (or Tab, or "Skip to work") swaps the headline for all four section
 *    cards at once, each tied to a landmark (BC Place → Experience, etc.).
 *  - With JS + WebGL: the live 3D scene (src/hero/, loaded lazily) fades in over the poster. Hovering or
 *    focusing a card turns the camera to its landmark; the cursor (desktop) or device tilt (phones) adds a
 *    gentle look-around. Hotspot markers sit on the landmarks; following one (or a card) flies the camera in.
 *  - Reduced motion / no JS / no WebGL: poster + headline, and the section cards below the hero (index.astro).
 */
import '@fontsource-variable/unbounded'; // the name only (chosen 2026-11-21)
import { getImage } from 'astro:assets';
import posterDesktop from '../assets/hero/poster-desktop.jpg';
import posterPhone from '../assets/hero/poster-phone.jpg';
import { heroStops } from '../data/hero-stops';

interface Props {
  title: string;
  subheading: string;
  /** One-line summary under the name. */
  summary: string;
}
const { title, subheading, summary } = Astro.props;

const srcset = async (src: ImageMetadata, widths: number[]) =>
  (await Promise.all(widths.map((width) => getImage({ src, width, format: 'webp' })))).map((img, i) => `${img.src} ${widths[i]}w`).join(', ');
const desktopSet = await srcset(posterDesktop, [960, 1440, 1920, 2880]);
const phoneSet = await srcset(posterPhone, [390, 585, 780]);
const fallback = await getImage({ src: posterDesktop, width: 1440, format: 'webp' });

const stops = await heroStops();
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="stage" data-stage>
    <picture class="poster">
      <source media="(orientation: portrait)" type="image/webp" srcset={phoneSet} sizes="100vw" />
      <source type="image/webp" srcset={desktopSet} sizes="100vw" />
      <img
        src={fallback.src}
        alt="A rendering of downtown Vancouver at blue hour, seen across False Creek from Olympic Village: lit towers, BC Place with its orange ring, and the North Shore mountains."
        width={posterDesktop.width}
        height={posterDesktop.height}
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <canvas class="scene" data-canvas aria-hidden="true"></canvas>
    <div class="shade" aria-hidden="true"></div>

    {/* Landmark markers (3D only). Following one flies the camera in, then opens the page. */}
    <div class="hotspots" data-hotspots>
      {
        stops.map((s) => (
          <a class="hotspot" href={s.href} data-hotspot={s.id} hidden tabindex="-1" aria-hidden="true">
            <span class="dot" />
            <span class="tag">
              <span class="place">{s.place}</span>
              <span class="section">{s.label}</span>
            </span>
          </a>
        ))
      }
    </div>

    <div class="copy" data-copy>
      <h1 id="hero-title" class="name" data-name>
        <span class="name-line" data-text="Jacob">Jacob</span>{' '}
        <span class="name-line" data-text="Van Luven">Van Luven</span>
      </h1>
      <p class="summary">
        {summary.split(' · ').map((part, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> · </span>}
            <span class="part">{part}</span>
          </>
        ))}
      </p>
      <p class="headline">{title} <span class="subheading">{subheading}</span></p>
      <a class="skip" href="#work">Skip to work <span aria-hidden="true">↓</span></a>
    </div>

    {/* The sections: all four cards appear together after the first scroll. */}
    <ol class="cards" data-cards aria-label="Sections">
      {
        stops.map((s, i) => (
          <li class="card" style={`--i: ${i}`}>
            <a href={s.href} data-go={s.id}>
              <span class="place">{s.place}</span>
              <span class="name">
                {s.label} <span class="arrow" aria-hidden="true">→</span>
              </span>
              <span class="desc">{s.description}</span>
            </a>
          </li>
        ))
      }
    </ol>

    <button class="tilt" type="button" data-tilt hidden>Tilt to look around</button>
    <p class="pan-hint" data-pan-hint hidden aria-hidden="true"><span>←</span> Drag to look along the waterfront <span>→</span></p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 32rem;
  }

  /* A little room to scroll while the stage stays pinned: the first scroll reveals the cards. Set before
     first paint (BaseLayout) so nothing shifts. */
  :global(html.hero-motion) .hero {
    height: 140svh;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 32rem;
    overflow: hidden;
    background: #060914;
  }

  .poster img,
  .scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .scene {
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .scene.ready {
    opacity: 1;
  }

  .shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, rgb(0 0 0 / 0.55), transparent 18%),
      linear-gradient(to top, rgb(4 6 14 / 0.75), transparent 45%);
  }

  .stage::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s ease;
  }

  .stage.leaving::after {
    opacity: 1;
  }

  .copy {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: clamp(2rem, 9svh, 6rem);
    max-width: 44rem;
    text-shadow: 0 2px 18px rgb(0 0 0 / 0.6);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .copy.away {
    opacity: 0;
    transform: translateY(1rem);
    visibility: hidden;
    transition: opacity 0.35s ease, transform 0.35s ease, visibility 0s linear 0.35s;
  }

  /* The name: big extruded letters, lit like signage. The extrusion is stacked text-shadows whose
     direction (--ex/--ey) follows the cursor, and the whole name tilts a little in 3D. */
  .name {
    --ex: 0.011em;
    --ey: 0.014em;
    --rx: 0deg;
    --ry: 0deg;
    margin: 0 0 0.9rem;
    font-family: 'Unbounded Variable', var(--font-display);
    font-weight: 800;
    font-size: clamp(2.8rem, 7.4vw, 5.9rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #fff3e6;
    text-shadow:
      calc(var(--ex) * 1) calc(var(--ey) * 1) 0 rgb(232, 108, 30),
      calc(var(--ex) * 2) calc(var(--ey) * 2) 0 rgb(215, 100, 28),
      calc(var(--ex) * 3) calc(var(--ey) * 3) 0 rgb(198, 91, 25),
      calc(var(--ex) * 4) calc(var(--ey) * 4) 0 rgb(181, 83, 23),
      calc(var(--ex) * 5) calc(var(--ey) * 5) 0 rgb(164, 75, 21),
      calc(var(--ex) * 6) calc(var(--ey) * 6) 0 rgb(147, 66, 18),
      calc(var(--ex) * 7) calc(var(--ey) * 7) 0 rgb(131, 58, 16),
      calc(var(--ex) * 8) calc(var(--ey) * 8) 0 rgb(114, 49, 13),
      calc(var(--ex) * 9) calc(var(--ey) * 9) 0 rgb(97, 41, 11),
      calc(var(--ex) * 10) calc(var(--ey) * 10) 0 rgb(80, 33, 9),
      calc(var(--ex) * 11) calc(var(--ey) * 11) 0 rgb(63, 24, 6),
      calc(var(--ex) * 12) calc(var(--ey) * 12) 0 rgb(46, 16, 4),
      calc(var(--ex) * 14) calc(var(--ey) * 16) 0.18em rgb(0 0 0 / 0.65),
      0 0 0.45em rgb(255 122 26 / 0.28);
    transform: perspective(70rem) rotateX(var(--rx)) rotateY(var(--ry));
    transform-origin: 20% 60%;
    transition: transform 0.25s ease-out;
  }

  .name-line {
    position: relative;
    display: block;
    width: fit-content;
  }

  /* A slow highlight sweeping across the face of the letters. */
  .name-line::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    text-shadow: none;
    color: transparent;
    background: linear-gradient(100deg, transparent 35%, rgb(255 255 255 / 0.85) 50%, transparent 65%) no-repeat;
    background-size: 250% 100%;
    background-position: 120% 0;
    -webkit-background-clip: text;
    background-clip: text;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .name-line::after {
      animation: sheen 7s ease-in-out 1.2s infinite;
    }

    .name-line + .name-line::after {
      animation-delay: 1.45s;
    }
  }

  @keyframes sheen {
    0% { background-position: 120% 0; }
    30%, 100% { background-position: -20% 0; }
  }

  .summary {
    margin: 0 0 1.1rem;
    font: 500 clamp(0.78rem, 1.3vw, 0.95rem) var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-soft);
  }

  .summary .part {
    white-space: nowrap;
  }

  @media (max-width: 30rem) {
    .summary {
      font-size: 0.7rem;
      letter-spacing: 0.035em;
    }
  }

  .headline {
    max-width: 34rem;
    margin: 0 0 1.25rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.15rem, 2.1vw, 1.6rem);
    line-height: 1.3;
    color: var(--text);
  }

  .subheading {
    color: var(--accent);
    white-space: nowrap;
  }

  .skip,
  .go {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1.1rem;
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: 999px;
    background: rgb(10 10 10 / 0.45);
    color: var(--text);
    font: 500 0.875rem var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    text-shadow: none;
    backdrop-filter: blur(6px);
  }

  .skip:hover,
  .go:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* ---- Section cards ---- */
  .cards {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Without the reveal (reduced motion, or before the script runs) the cards stay out of the way;
     the same sections are linked below the hero. */
  .card {
    display: none;
  }

  :global(html.hero-motion) .cards {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: clamp(1.25rem, 5svh, 3rem);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    max-width: 72rem;
    margin-inline: auto;
    pointer-events: none;
  }

  :global(html.hero-motion) .card {
    display: block;
    max-width: none;
    opacity: 0;
    transform: translateY(1.25rem);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .cards.shown .card {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    transition: opacity 0.45s ease calc(var(--i) * 70ms), transform 0.45s ease calc(var(--i) * 70ms);
  }

  .card a {
    display: grid;
    gap: 0.3rem;
    align-content: start;
    height: 100%;
    padding: 1rem 1.1rem 1.1rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 12px;
    background: rgb(8 9 14 / 0.72);
    backdrop-filter: blur(10px);
    box-shadow: 0 16px 48px rgb(0 0 0 / 0.4);
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .card a:hover,
  .card a:focus-visible,
  .card a.active {
    border-color: var(--accent);
    background: rgb(14 12 12 / 0.82);
  }

  .card .place {
    font: 500 0.75rem var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-soft);
  }

  .card .name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    line-height: 1.15;
  }

  .card .arrow {
    color: var(--accent);
    transition: transform 0.2s ease;
    display: inline-block;
  }

  .card a:hover .arrow,
  .card a:focus-visible .arrow {
    transform: translateX(0.25rem);
  }

  .card .desc {
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--text-muted);
  }

  /* ---- Hotspot markers ---- */
  .hotspots {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hotspot {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem;
    margin: -1.375rem 0 0 -1.375rem;
    color: var(--text);
    text-decoration: none;
    pointer-events: auto;
    will-change: transform;
  }

  .hotspot[hidden] {
    display: none;
  }

  .dot {
    position: relative;
    width: 1.75rem;
    height: 1.75rem;
    flex: none;
    border-radius: 999px;
    border: 2px solid var(--accent);
    background: rgb(255 122 26 / 0.18);
    box-shadow: 0 0 12px rgb(255 122 26 / 0.6);
    transition: transform 0.3s ease;
  }

  .dot::after {
    content: '';
    position: absolute;
    inset: 0.45rem;
    border-radius: 999px;
    background: var(--accent);
  }

  .hotspot.active .dot {
    transform: scale(1.25);
  }

  @media (prefers-reduced-motion: no-preference) {
    .dot {
      animation: pulse 2.4s ease-in-out infinite;
    }
  }

  @keyframes pulse {
    50% {
      box-shadow: 0 0 22px rgb(255 122 26 / 0.95);
    }
  }

  .tag {
    display: grid;
    padding: 0.3rem 0.65rem;
    border-radius: 6px;
    background: rgb(8 8 10 / 0.78);
    border: 1px solid rgb(255 255 255 / 0.12);
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-0.25rem);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .tag .place {
    font: 500 0.6875rem var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .tag .section {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
  }

  .hotspot:hover .tag {
    opacity: 1;
    transform: none;
  }

  /* Horizontal look-around: grab the skyline (vertical scrolling still works on touch). */
  .stage {
    touch-action: pan-y;
  }

  .scene.ready {
    cursor: grab;
  }

  .stage.dragging .scene {
    cursor: grabbing;
  }

  .pan-hint {
    position: absolute;
    left: 50%;
    top: clamp(4.75rem, 12svh, 6.5rem);
    margin: 0;
    padding: 0.4rem 0.85rem;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 999px;
    background: rgb(8 8 10 / 0.55);
    backdrop-filter: blur(6px);
    color: var(--text-muted);
    font: 500 0.75rem var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    transform: translateX(-50%);
    pointer-events: none;
    transition: opacity 0.6s ease;
  }

  .pan-hint[hidden] {
    display: block;
    opacity: 0;
  }

  .pan-hint span {
    color: var(--accent);
  }

  .tilt {
    position: absolute;
    left: var(--gutter);
    top: 5rem;
    min-height: 2.75rem;
    padding: 0 0.9rem;
    border: 1px solid rgb(255 255 255 / 0.3);
    border-radius: 999px;
    background: rgb(10 10 10 / 0.5);
    color: var(--text-muted);
    font: 500 0.75rem var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .tilt[hidden] {
    display: none;
  }

  /* Phones and narrow screens: a 2 × 2 grid over the calm water at the bottom, names only. */
  @media (max-width: 48rem), (orientation: portrait) {
    :global(html.hero-motion) .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.5rem;
      bottom: clamp(1rem, 4svh, 2rem);
    }

    .card a {
      padding: 0.75rem 0.85rem;
    }

    .card .desc {
      display: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-hero]');
  const html = document.documentElement;
  const motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

  function webglAvailable() {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  }

  /**
   * Start the 3D scene on the first sign of a visitor (scroll, pointer, touch, key) or ~4 s after load,
   * whichever comes first. The poster shows the same view meanwhile, and the heavy work stays out of the
   * critical loading window.
   */
  function whenEngaged(fn: () => void) {
    let done = false;
    const events = ['scroll', 'pointermove', 'pointerdown', 'touchstart', 'keydown', 'wheel'];
    const go = () => {
      if (done) return;
      done = true;
      events.forEach((t) => window.removeEventListener(t, go));
      fn();
    };
    events.forEach((t) => window.addEventListener(t, go, { passive: true, once: true }));
    const timer = () => setTimeout(() => ('requestIdleCallback' in window ? requestIdleCallback(go, { timeout: 1500 }) : go()), 4000);
    if (document.readyState === 'complete') timer();
    else window.addEventListener('load', timer, { once: true });
  }

  /** The name's depth follows the cursor: the letters tilt toward it and the extrusion swings away. */
  function setUpName(root: HTMLElement) {
    const name = root.querySelector<HTMLElement>('[data-name]');
    if (!name || !window.matchMedia('(pointer: fine)').matches) return;
    let raf = 0, x = 0, y = 0;
    window.addEventListener('pointermove', (e) => {
      x = e.clientX / innerWidth - 0.5;
      y = e.clientY / innerHeight - 0.5;
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        name.style.setProperty('--ry', `${(x * 10).toFixed(2)}deg`);
        name.style.setProperty('--rx', `${(-y * 8).toFixed(2)}deg`);
        name.style.setProperty('--ex', `${(0.011 - x * 0.016).toFixed(4)}em`);
        name.style.setProperty('--ey', `${(0.014 - y * 0.012).toFixed(4)}em`);
      });
    }, { passive: true });
  }

  if (root && motionOK) {
    setUpName(root);
    const tour = setUpTour(root);
    if (webglAvailable()) whenEngaged(() => start(root, tour));
  } else {
    html.classList.remove('hero-motion');
  }

  /**
   * The reveal: any scroll past the top (or Tab into the cards, or "Skip to work") swaps the headline for
   * the four section cards. `focus` is the card being hovered or focused (its landmark id), if any.
   */
  function setUpTour(root: HTMLElement) {
    const list = root.querySelector<HTMLElement>('[data-cards]')!;
    const links = [...root.querySelectorAll<HTMLAnchorElement>('[data-go]')];
    const copy = root.querySelector<HTMLElement>('[data-copy]')!;
    const skip = root.querySelector<HTMLAnchorElement>('.skip')!;
    const state = { revealed: false, focus: null as string | null };
    let focusedInside = false;

    const highlight = (id: string | null) => {
      state.focus = id;
      links.forEach((a) => a.classList.toggle('active', a.dataset.go === id));
      root.querySelectorAll('[data-hotspot]').forEach((h) => h.classList.toggle('active', h.getAttribute('data-hotspot') === id));
    };
    const update = () => {
      const revealed = focusedInside || -root.getBoundingClientRect().top > 24;
      if (revealed === state.revealed) return;
      state.revealed = revealed;
      list.classList.toggle('shown', revealed);
      copy.classList.toggle('away', revealed);
      if (!revealed) highlight(null);
    };

    for (const a of links) {
      a.addEventListener('pointerenter', () => highlight(a.dataset.go!));
      a.addEventListener('pointerleave', () => highlight(null));
      a.addEventListener('focus', () => highlight(a.dataset.go!));
      a.addEventListener('blur', () => highlight(null));
    }
    // Hovering a marker lights up its card too.
    root.querySelectorAll<HTMLElement>('[data-hotspot]').forEach((h) => {
      h.addEventListener('pointerenter', () => highlight(h.dataset.hotspot!));
      h.addEventListener('pointerleave', () => highlight(null));
    });
    // Keyboard: tabbing into the cards reveals them even at the top of the page.
    list.addEventListener('focusin', () => { focusedInside = true; update(); });
    list.addEventListener('focusout', (e) => {
      if (list.contains(e.relatedTarget as Node)) return;
      focusedInside = false;
      update();
    });
    // "Skip to work" reveals the cards in place (one short scroll) instead of jumping past the hero.
    skip.addEventListener('click', (e) => {
      e.preventDefault();
      window.scrollTo({ top: root.getBoundingClientRect().top + scrollY + innerHeight * 0.2, behavior: 'smooth' });
      links[0]?.focus({ preventScroll: true });
    });
    window.addEventListener('scroll', update, { passive: true });
    update();
    return { state, ids: links.map((a) => a.dataset.go!) };
  }

  async function start(root: HTMLElement, tour: ReturnType<typeof setUpTour>) {
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const tiltButton = root.querySelector<HTMLButtonElement>('[data-tilt]')!;
    const spots = [...root.querySelectorAll<HTMLAnchorElement>('[data-hotspot]')];
    const coarse = window.matchMedia('(pointer: coarse)').matches;
    const isPhone = coarse && Math.min(screen.width, screen.height) < 820;

    const { startHero } = await import('../hero/runtime.js');

    // Look-around input, smoothed per frame.
    const look = { yaw: 0, pitch: 0, targetYaw: 0, targetPitch: 0 };
    if (!coarse) {
      window.addEventListener('pointermove', (e) => {
        look.targetYaw = (e.clientX / innerWidth - 0.5) * 5;
        look.targetPitch = -(e.clientY / innerHeight - 0.5) * 1.6;
      }, { passive: true });
    }
    const onTilt = (e: DeviceOrientationEvent) => {
      if (e.gamma === null) return;
      look.targetYaw = Math.max(-1, Math.min(1, e.gamma / 25)) * 7;
    };
    const DOE = window.DeviceOrientationEvent as unknown as { requestPermission?: () => Promise<string> } | undefined;
    if (coarse && DOE) {
      if (typeof DOE.requestPermission === 'function') {
        tiltButton.hidden = false; // iOS: permission must come from a tap; if declined, the view stays still
        tiltButton.addEventListener('click', async () => {
          tiltButton.hidden = true;
          try {
            if ((await DOE.requestPermission!()) === 'granted') window.addEventListener('deviceorientation', onTilt);
          } catch { /* no tilt */ }
        }, { once: true });
      } else {
        window.addEventListener('deviceorientation', onTilt);
      }
    }

    type View = { bearing: number; pitch: number; fov: number };
    let flight: { from: View; to: View; t0: number; href: string } | null = null;
    let current: View | null = null;
    let base: View | null = null;
    let lastNow = 0;
    const portraitNow = () => innerWidth < innerHeight;
    // Horizontal pan (degrees from the opening bearing): from the Cambie Bridge on the left to Science World
    // on the right. Limits keep the edges of the frame inside the city data (compass 258° … 74°).
    const pan = { value: 0, velocity: 0, dragging: false, coasting: false, lastT: 0 };
    let PAN_MIN = -30, PAN_MAX = 80;
    const panLimits = (f: View) => {
      const hfov = 2 * Math.atan(Math.tan((f.fov * Math.PI) / 360) * (innerWidth / innerHeight)) * (180 / Math.PI);
      PAN_MIN = Math.min(0, 258 + hfov / 2 - f.bearing);
      PAN_MAX = Math.max(0, 74 + 360 - hfov / 2 - f.bearing);
    };
    const clampPan = (v: number) => Math.min(PAN_MAX, Math.max(PAN_MIN, v));
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);
    const angleLerp = (a: number, b: number, t: number) => a + ((((b - a) % 360) + 540) % 360 - 180) * t;
    const FLIGHT_MS = 1100;

    let ctl: Awaited<ReturnType<typeof startHero>>;
    try {
      ctl = await startHero({
        canvas,
        container: stage,
        layout: isPhone ? 'phone' : 'desktop',
        dataUrl: '/data/skyline.json',
        onFrame(hero, now) {
          const f = hero.framing;
          // Target view: the opening shot; once the cards are up, a touch lower so the skyline sits above
          // them; with a card hovered/focused, turned toward its landmark with a slightly tighter lens.
          panLimits(f);
          pan.value = clampPan(pan.value);
          // Coast after a flick, slowing to a stop.
          if (pan.coasting && !pan.dragging) {
            const dts = Math.min(0.1, (now - (pan.lastT || now)) / 1000);
            pan.value = clampPan(pan.value + pan.velocity * dts);
            pan.velocity *= Math.exp(-dts * 3.2);
            if (Math.abs(pan.velocity) < 0.5 || pan.value === PAN_MIN || pan.value === PAN_MAX) pan.coasting = false;
            ctl?.poke();
          }
          pan.lastT = now;
          let target: View = { bearing: f.bearing + pan.value, pitch: f.pitch, fov: f.fov };
          if (tour.state.revealed) target = { bearing: f.bearing + pan.value, pitch: f.pitch - (portraitNow() ? 2.5 : 1.8), fov: f.fov };
          const v = tour.state.focus ? hero.viewOf(tour.state.focus) : null;
          if (v) target = { bearing: v.bearing, pitch: target.pitch + Math.max(-2, Math.min(3, v.pitch)) * 0.5, fov: f.fov * 0.82 };
          // Ease toward it (frame-rate independent).
          const dt = Math.min(0.1, (now - (lastNow || now)) / 1000);
          lastNow = now;
          const k = 1 - Math.exp(-dt / (pan.dragging || pan.coasting ? 0.06 : 0.45));
          base = base ? {
            bearing: angleLerp(base.bearing, target.bearing, k),
            pitch: base.pitch + (target.pitch - base.pitch) * k,
            fov: base.fov + (target.fov - base.fov) * k,
          } : target;
          if (Math.abs(angleLerp(base.bearing, target.bearing, 1) - base.bearing) + Math.abs(base.pitch - target.pitch) > 0.05) ctl?.poke();
          look.yaw += (look.targetYaw - look.yaw) * 0.08;
          look.pitch += (look.targetPitch - look.pitch) * 0.08;
          let view: View = { bearing: base.bearing + look.yaw, pitch: base.pitch + look.pitch, fov: base.fov };
          if (flight) {
            const t = Math.min(1, (now - flight.t0) / FLIGHT_MS);
            const k = ease(t);
            view = {
              bearing: angleLerp(flight.from.bearing, flight.to.bearing, k),
              pitch: flight.from.pitch + (flight.to.pitch - flight.from.pitch) * k,
              fov: flight.from.fov + (flight.to.fov - flight.from.fov) * k,
            };
            ctl?.poke();
            if (t > 0.6) stage.classList.add('leaving');
            if (t >= 1) { const href = flight.href; flight = null; window.location.assign(href); }
          }
          current = view;
          hero.look(view);

          for (const el of spots) {
            const pt = hero.project(el.dataset.hotspot!);
            const show = !!pt && pt.x > 24 && pt.x < innerWidth - 24 && pt.y > 70 && pt.y < innerHeight - 24;
            if (el.hidden === show) el.hidden = !show;
            if (show) el.style.transform = `translate(${pt!.x.toFixed(1)}px, ${pt!.y.toFixed(1)}px)`;
          }
        },
      });
    } catch (err) {
      console.warn('Skyline hero unavailable, keeping the still image.', err);
      return;
    }

    canvas.classList.add('ready');
    setUpPan();

    /** Drag (mouse), swipe (touch), horizontal wheel/trackpad and arrow keys pan along the waterfront. */
    function setUpPan() {
      const hint = root.querySelector<HTMLElement>('[data-pan-hint]')!;
      if (coarse) hint.innerHTML = '<span>←</span> Swipe to look along the waterfront <span>→</span>';
      requestAnimationFrame(() => (hint.hidden = false));
      let hintTimer = setTimeout(() => (hint.hidden = true), 9000);
      const used = () => { hint.hidden = true; clearTimeout(hintTimer); };
      // Degrees per CSS pixel: the scene follows the finger/cursor.
      const degPerPx = () => {
        const fov = current?.fov ?? ctl.hero.framing.fov;
        const hfov = 2 * Math.atan(Math.tan((fov * Math.PI) / 360) * (innerWidth / innerHeight)) * (180 / Math.PI);
        return hfov / innerWidth;
      };
      let start: { id: number; x: number; y: number; decided: boolean; lastX: number; lastT: number } | null = null;
      stage.addEventListener('pointerdown', (e) => {
        if (e.button !== 0 || (e.target as Element).closest('a, button, .copy, .cards')) return;
        start = { id: e.pointerId, x: e.clientX, y: e.clientY, decided: false, lastX: e.clientX, lastT: performance.now() };
        pan.coasting = false;
        pan.velocity = 0;
      });
      stage.addEventListener('pointermove', (e) => {
        if (!start || e.pointerId !== start.id) return;
        const dx = e.clientX - start.x, dy = e.clientY - start.y;
        if (!start.decided) {
          if (Math.hypot(dx, dy) < 6) return;
          start.decided = true;
          if (Math.abs(dx) < Math.abs(dy)) { start = null; return; } // a vertical swipe: let the page scroll
          pan.dragging = true;
          stage.classList.add('dragging');
          try { stage.setPointerCapture(e.pointerId); } catch { /* synthetic or ended pointer */ }
          used();
        }
        const t = performance.now();
        const step = -(e.clientX - start.lastX) * degPerPx();
        pan.value = clampPan(pan.value + step);
        const dtm = Math.max(1, t - start.lastT) / 1000;
        pan.velocity = pan.velocity * 0.5 + (step / dtm) * 0.5;
        start.lastX = e.clientX;
        start.lastT = t;
        ctl.poke();
      });
      const end = (e: PointerEvent) => {
        if (!start || e.pointerId !== start.id) return;
        if (pan.dragging) {
          pan.dragging = false;
          pan.coasting = Math.abs(pan.velocity) > 2 && performance.now() - start.lastT < 120;
          stage.classList.remove('dragging');
        }
        start = null;
      };
      stage.addEventListener('pointerup', end);
      stage.addEventListener('pointercancel', end);
      // Trackpads: two-finger horizontal scroll (or Shift + wheel).
      stage.addEventListener('wheel', (e) => {
        const dx = e.shiftKey && !e.deltaX ? e.deltaY : e.deltaX;
        if (Math.abs(dx) <= Math.abs(e.shiftKey ? 0 : e.deltaY)) return;
        e.preventDefault();
        pan.value = clampPan(pan.value + dx * degPerPx());
        pan.coasting = false;
        pan.dragging = false;
        used();
        ctl.poke();
      }, { passive: false });
      // Keyboard: left/right arrows while the skyline is on screen (not while typing or in a menu).
      window.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
        if (e.altKey || e.metaKey || e.ctrlKey || root.getBoundingClientRect().bottom < innerHeight * 0.5) return;
        if ((e.target as Element).closest?.('input, textarea, select, [contenteditable], nav')) return;
        pan.value = clampPan(pan.value + (e.key === 'ArrowLeft' ? -12 : 12));
        used();
        ctl.poke();
      });
    }

    // Following a marker or a card's link: fly the camera to the landmark, then open the page.
    const fly = (id: string, href: string, e: MouseEvent) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0 || flight || !current) return;
      const target = ctl.hero.viewOf(id);
      if (!target) return;
      e.preventDefault();
      flight = { from: current, to: { ...target, fov: current.fov * 0.45 }, t0: performance.now(), href };
      ctl.poke();
    };
    for (const a of spots) a.addEventListener('click', (e) => fly(a.dataset.hotspot!, a.href, e));
    for (const a of root.querySelectorAll<HTMLAnchorElement>('[data-go]')) a.addEventListener('click', (e) => fly(a.dataset.go!, a.href, e));
    window.addEventListener('pageshow', () => stage.classList.remove('leaving'));
  }
</script>
