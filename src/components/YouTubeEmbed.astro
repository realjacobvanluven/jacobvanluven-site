---
/**
 * Click-to-load YouTube embed. Nothing from YouTube loads until the visitor activates the button;
 * then an iframe from youtube-nocookie.com replaces the poster. The 16:9 box is fixed, so nothing shifts.
 * Without JavaScript only the "Watch on YouTube" link works.
 */
interface Props {
  id: string;
  url: string;
  title: string;
  buttonLabel: string;
  /** Small line shown on the poster (no YouTube image is used). */
  posterKicker?: string;
}

const { id, url, title, buttonLabel, posterKicker } = Astro.props;
---

<div class="yt" data-yt-id={id} data-yt-title={title}>
  <div class="frame">
    <button type="button" class="poster" aria-label={buttonLabel} hidden>
      {posterKicker && <span class="kicker label">{posterKicker}</span>}
      <span class="play" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="28" height="28"><path d="M8 5v14l11-7z" fill="currentColor"></path></svg>
      </span>
      <span class="poster-title" aria-hidden="true">{title}</span>
    </button>
  </div>
  <p class="watch"><a href={url} rel="noopener">Watch on YouTube <span aria-hidden="true">↗</span></a></p>
</div>

<style>
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    width: 100%;
    max-width: 40rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }

  .frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .poster {
    position: absolute;
    inset: 0;
    width: 100%;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem;
    border: 0;
    cursor: pointer;
    text-align: left;
    color: var(--text);
    background:
      radial-gradient(120% 90% at 85% 110%, rgb(255 122 26 / 0.28), transparent 60%),
      linear-gradient(160deg, #181513, var(--bg));
  }

  .poster:not([hidden]) {
    display: flex;
  }

  /* No JavaScript: the poster stays hidden, so drop the empty box and leave just the link. */
  .frame:has(.poster[hidden]) {
    display: none;
  }

  .poster:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: -6px;
  }

  .kicker {
    margin: 0;
  }

  .play {
    align-self: center;
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 50%;
    background: var(--accent);
    color: #0a0a0a;
    transition: transform 0.15s;
  }

  .poster:hover .play {
    transform: scale(1.08);
  }

  .poster-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(0.95rem, 3.6vw, 1.15rem);
    line-height: 1.2;
    text-wrap: balance;
  }

  .watch {
    margin: 0.6rem 0 0;
    font-size: 0.9rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .play {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.yt[data-yt-id]').forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>('.poster');
    const frame = root.querySelector<HTMLElement>('.frame');
    if (!button || !frame) return;
    button.hidden = false; // the poster button only exists when JavaScript can make it work
    button.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${root.dataset.ytId}?autoplay=1&rel=0`;
      iframe.title = root.dataset.ytTitle ?? 'Video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      button.replaceWith(iframe);
      iframe.focus();
    });
  });
</script>
