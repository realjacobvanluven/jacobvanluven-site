---
import { getCollection } from 'astro:content';
import { nav, site, toolsNavItem } from '../data/site';

const publishedTools = await getCollection('tools', (t) => !t.data.draft);
const items = publishedTools.length > 0 ? [...nav.slice(0, 3), toolsNavItem, ...nav.slice(3)] : nav;

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <a class="wordmark" href="/" aria-current={path === '/' ? 'page' : undefined}>{site.name}</a>
  <nav aria-label="Main">
    <ul>
      {
        items.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.25rem var(--gutter);
    border-bottom: 1px solid var(--border);
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--text);
    text-decoration: none;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-block;
    padding: 0.35rem 0; /* larger tap target on mobile */
    font-size: 0.9375rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--accent);
  }

  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }
</style>
