---
import { Image, getImage } from 'astro:assets';
import type { Story } from '../lib/stories';

type Media = Story['data']['media'][number];

interface Props {
  item: Media;
  /** Rendered width budget, used for responsive image sizes. */
  sizes?: string;
}

const { item, sizes = '(min-width: 48rem) 34rem, calc(100vw - 2rem)' } = Astro.props;

// "Open full size" points at an optimized full-width WebP, so the original PNG never ships.
const fullSize = item.type === 'image' ? await getImage({ src: item.src, width: item.src.width, format: 'webp' }) : null;
---

{
  item.type === 'image' && (
    <a class="media media-image" href={fullSize!.src} aria-label={`Open full-size image: ${item.alt}`}>
      <Image src={item.src} alt={item.alt} widths={[400, 680, 1080]} {sizes} loading="lazy" />
    </a>
  )
}
{
  item.type === 'video' && (
    <video
      class="media media-video"
      style={`aspect-ratio: ${item.aspect}`}
      src={`${item.src}#t=0.1`}
      controls
      playsinline
      preload="metadata"
      aria-label={item.label}
    />
  )
}
{
  item.type === 'audio' && (
    <figure class="media media-audio">
      <audio src={item.src} controls preload="none" aria-label={item.label} />
      <figcaption class="label">{item.label}</figcaption>
    </figure>
  )
}

<style>
  .media {
    display: block;
    max-width: 100%;
  }

  .media-image img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
  }

  .media-video {
    width: 100%;
    max-height: 36rem;
    background: var(--surface);
    border-radius: 6px;
  }

  .media-audio {
    margin: 0;
  }

  .media-audio audio {
    width: 100%;
  }

  .media-audio figcaption {
    margin-top: 0.4rem;
    text-transform: none;
    letter-spacing: 0;
  }
</style>
