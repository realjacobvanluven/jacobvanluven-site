---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceTimeline from '../components/experience/ExperienceTimeline.astro';
import { getStations } from '../lib/experience';

const stations = await getStations();
---

<BaseLayout
  title="Experience"
  description="Jacob Van Luven's work history at BCI and the Emergency Planning Secretariat, plus education at Kwantlen Polytechnic University and Langara College."
>
  <p class="back"><a href="/">↖ Back to the skyline</a></p>
  <h1>Experience</h1>
  <p class="intro">Four stops at BCI, one at EPS, and the schools that got me there.</p>
  <ExperienceTimeline stations={stations} />
</BaseLayout>

<style>
  .intro {
    margin: -0.5rem 0 1.75rem;
    font-size: 1.125rem;
    color: var(--text-muted);
  }

  .back {
    margin: 0 0 0.75rem;
    font: 500 0.8125rem var(--font-mono);
    letter-spacing: 0.04em;
  }

  .back a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .back a:hover {
    color: var(--text);
    text-decoration: underline;
  }
</style>
