---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatRange } from '../lib/format';
import { getStations } from '../lib/experience';

const roles = await getStations();
const rendered = await Promise.all(roles.map(async (r) => ({ role: r, Content: (await render(r)).Content })));
---

<BaseLayout title="Experience" description="Jacob Van Luven's work history at BCI and the Emergency Planning Secretariat.">
  <h1>Experience</h1>
  <ol class="timeline">
    {
      rendered.map(({ role: { data }, Content }) => (
        <li>
          {data.start && <p class="label">{formatRange(data.start, data.end)}</p>}
          <h2>{data.role}</h2>
          <p class="meta">
            {data.org}
            {data.location && ` · ${data.location}`}
            {data.mode && ` (${data.mode})`}
          </p>
          {data.summary && <p>{data.summary}</p>}
          {data.tags.length > 0 && (
            <ul class="skills">
              {data.tags.map((t) => (
                <li>{t.label}</li>
              ))}
            </ul>
          )}
          <Content />
        </li>
      ))
    }
  </ol>
</BaseLayout>
