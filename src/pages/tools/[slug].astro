---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const tools = await getCollection('tools', (t) => !t.data.draft);
  return tools.map((tool) => ({ params: { slug: tool.id }, props: { tool } }));
}

interface Props {
  tool: CollectionEntry<'tools'>;
}

const { tool } = Astro.props;
const { Content } = await render(tool);
---

<BaseLayout title={tool.data.title} description={tool.data.description}>
  <p class="label"><a href="/tools/">Tools</a> / {tool.data.status}</p>
  <h1>{tool.data.title}</h1>
  <p>{tool.data.description}</p>
  <!-- Each tool's interactive island goes in its MDX body. -->
  <Content />
</BaseLayout>
